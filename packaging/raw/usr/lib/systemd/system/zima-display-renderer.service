[Unit]
Description=Zima Display HDMI renderer
After=systemd-logind.service local-fs.target getty@tty1.service zimaos-welcome@tty1.service
PartOf=zima-display.service
# Both console providers can hang up tty1; finish stopping them before taking it.
Conflicts=getty@tty1.service zimaos-welcome@tty1.service

[Service]
Type=simple
ExecStart=/usr/libexec/zima-display/start-renderer
Restart=on-failure
RestartSec=2
KillMode=control-group
SupplementaryGroups=video render audio
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYReset=yes
# The renderer owns tty1. Hanging it up also terminates mpv/the supervisor.
TTYVHangup=no
TTYVTDisallocate=yes
